# Base URL of the FastAPI backend, including its API prefix.
# Same backend the Staff Portal talks to.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Must match API_KEY in the backend's .env (sent as the x-api-key header).
# NOTE: this is the app-level key, not a per-patient credential. Per-patient
# auth is layered on top via the patient session token — see BACKEND_REQUIREMENTS.md.
VITE_API_KEY=dev-secret-key-1234
